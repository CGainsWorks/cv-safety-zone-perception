# Export image.  Kept separate on purpose: it installs torch and yolox, which
# the runtime image has no use for.  YOLOX is Apache-2.0; see docs/licences.md.
#
#   docker build -f docker/Dockerfile.export -t szp-export:latest .
#   docker run --rm -v "$PWD/models:/app/models" szp-export:latest
#
# It runs once, produces models/yolox_tiny.onnx and models/model_card.json and
# is never deployed.  build-essential is there because yolox's setup.py
# compiles its optional C++ COCO evaluator on Linux.

FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-export.txt requirements-yolox.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-export.txt \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation \
         -r requirements-yolox.txt

COPY src/ ./src/
COPY scripts/ ./scripts/

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1

CMD ["python", "scripts/fetch_model.py", "--models-dir", "/app/models"]
